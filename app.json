{
  "expo": {
    "name": "Ratecade",
    "slug": "vscore",
    "version": "2.0.1",
    "orientation": "portrait",
    "scheme": "ratecade",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/Icone/NewLogo.png",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/Icone/NewLogo.png",
          "color": "#7B2FBE"
        }
      ],
      "expo-localization",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.68957425502-q3csqeuus9d8qnrpicdd7c8knqno95a3"
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jdecesco.vscore",
      "buildNumber": "9",
      "usesAppleSignIn": true,
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)$(CFBundleIdentifier)"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
          "NSPhotoLibraryUsageDescription": "Ratecade accesses your photo library so you can choose a profile picture to personalize your account.",
          "NSCameraUsageDescription": "Ratecade uses the camera so you can take a photo to set as your profile picture.",
          "NSMicrophoneUsageDescription": "Ratecade may access the microphone when recording a video for your profile picture."
      }
    },
    "android": {
      "package": "com.jdecesco.vscore",
      "adaptiveIcon": {
        "backgroundColor": "#0D0D1A"
      }
    },
    "extra": {
      "eas": {
        "projectId": "1d40d06f-9080-4052-bbc6-bd002bb1d635"
      }
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#07071A"
    }
  }
}
